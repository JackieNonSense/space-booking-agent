# Copy to .env.local for local development. On Vercel, set these in
# Project Settings → Environment Variables.

# Required: Claude API key from https://platform.claude.com
ANTHROPIC_API_KEY=

# Optional: model and effort (defaults: claude-opus-5-5, medium)
# ANTHROPIC_MODEL=claude-opus-5-5
# ANTHROPIC_EFFORT=medium

# Postgres (Neon). Leave empty locally to use an embedded PGlite database in ./.data
# Tables are created automatically on first use (`npm run db:setup` also works).
DATABASE_URL=

# Email via Resend. Without RESEND_API_KEY, emails are logged instead of sent.
RESEND_API_KEY=
# Must use a domain verified in Resend, e.g. "Eastern Essence Bookings <bookings@mail.example.com>"
EMAIL_FROM=
# Optional: copy every confirmation to the studio, and where replies go
EMAIL_BCC=
EMAIL_REPLY_TO=

# Optional: abuse limits for the public demo
# RATE_LIMIT_PER_HOUR=60
# RATE_LIMIT_PER_DAY=300
